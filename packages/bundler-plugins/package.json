{
  "name": "@sentry/bundler-plugins",
  "version": "11.12.0",
  "description": "Sentry Bundler Plugins",
  "repository": "git://github.com/getsentry/sentry-javascript.git",
  "homepage": "https://github.com/getsentry/sentry-javascript/tree/main/packages/bundler-plugins",
  "author": "Sentry",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "/build",
    "sentry-release-injection-file.js",
    "sentry-esbuild-debugid-injection-file.js"
  ],
  "main": "build/cjs/core/index.js",
  "module": "build/esm/core/index.js",
  "types": "build/types/core/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./webpack": {
      "types": "./build/types/webpack/index.d.ts",
      "import": "./build/esm/webpack/index.js",
      "require": "./build/cjs/webpack/index.js"
    },
    "./rollup": {
      "types": "./build/types/rollup/index.d.ts",
      "import": "./build/esm/rollup/index.js",
      "require": "./build/cjs/rollup/index.js"
    },
    "./vite": {
      "types": "./build/types/vite/index.d.ts",
      "import": "./build/esm/vite/index.js",
      "require": "./build/cjs/vite/index.js"
    },
    "./esbuild": {
      "types": "./build/types/esbuild/index.d.ts",
      "import": "./build/esm/esbuild/index.js",
      "require": "./build/cjs/esbuild/index.js"
    },
    "./bun": {
      "types": "./build/types/bun/index.d.ts",
      "import": "./build/esm/bun/index.js",
      "require": "./build/cjs/bun/index.js"
    },
    "./core": {
      "types": "./build/types/core/index.d.ts",
      "import": "./build/esm/core/index.js",
      "require": "./build/cjs/core/index.js"
    },
    "./loader-utils": {
      "types": "./build/types/loader-utils/index.d.ts",
      "import": "./build/esm/loader-utils/index.js",
      "require": "./build/cjs/loader-utils/index.js"
    },
    "./babel-plugin": {
      "types": "./build/types/babel-plugin/index.d.ts",
      "import": "./build/esm/babel-plugin/index.js",
      "require": "./build/cjs/babel-plugin/index.js"
    },
    "./sentry-release-injection-file": {
      "import": "./sentry-release-injection-file.js",
      "require": "./sentry-release-injection-file.js"
    },
    "./sentry-esbuild-debugid-injection-file": {
      "import": "./sentry-esbuild-debugid-injection-file.js",
      "require": "./sentry-esbuild-debugid-injection-file.js"
    },
    "./webpack-loader": {
      "require": "./build/cjs/webpack/component-annotation-transform.js"
    }
  },
  "scripts": {
    "build": "pnpm run \"/^build:(transpile|types)$/\"",
    "build:dev": "pnpm run build",
    "build:version": "node -p \"'export const LIB_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/core/version.ts",
    "build:transpile": "rolldown -c rollup.npm.config.mjs",
    "build:types": "tsc -p tsconfig.types.json",
    "build:tarball": "pnpm pack",
    "prebuild": "pnpm run build:version",
    "prelint:types": "pnpm run build:version",
    "pretest": "pnpm run build:version",
    "pretest:unit": "pnpm run build:version",
    "clean": "node ../../scripts/rm.mjs build dist coverage sentry-bundler-plugins-*.tgz",
    "clean:all": "pnpm run \"/^(clean|clean:deps)$/\"",
    "clean:deps": "node ../../scripts/rm.mjs node_modules",
    "lint": "oxlint . --type-aware",
    "lint:types": "oxlint src test --type-aware --type-check",
    "lint:fix": "oxlint . --fix --type-aware",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "nx": {
    "targets": {
      "build:transpile": {
        "dependsOn": [
          "build:version",
          "^build:transpile"
        ]
      },
      "build:types": {
        "dependsOn": [
          "build:version",
          "^build:types"
        ]
      }
    }
  },
  "dependencies": {
    "@sentry/core": "11.12.0",
    "dotenv": "^18.0.10",
    "glob": "^14.0.3",
    "magic-string": "~1.4.5",
    "oxc-parser": "^0.158.0",
    "sentry": "^0.49.0"
  },
  "peerDependencies": {
    "rollup": ">=3.2.0",
    "webpack": ">=5.1.0"
  },
  "peerDependenciesMeta": {
    "rollup": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/parser": "^8.0.10",
    "@babel/preset-react": "^8.0.1",
    "@sentry-internal/rollup-utils": "11.12.0",
    "@sentry-internal/test-utils": "11.12.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^20.19.0",
    "rolldown": "^1.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "webpack": "5.112.2"
  },
  "engines": {
    "node": ">=20.19.0 <22.0.0 || >=22.12.0 <23.0.0 || >=23.2.0"
  },
  "sideEffects": [
    "./sentry-release-injection-file.js",
    "./sentry-esbuild-debugid-injection-file.js"
  ]
}
